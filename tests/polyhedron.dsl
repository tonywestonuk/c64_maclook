# POLYHEDRON: solids turned by the WiC64's matrix unit
dclick 292 30
wait 60
dclick 55 142
wait 400
shot ph_ico1
wait 20
shot ph_ico2
cmd 1
wait 150
shot ph_tetra
cmd 2
wait 150
shot ph_cube
cmd 3
wait 150
shot ph_octa
cmd 4
wait 150
shot ph_dodeca
cmd 6
wait 250
shot ph_ball
cmd H
wait 250
shot ph_ball_wire
dump ph_state
