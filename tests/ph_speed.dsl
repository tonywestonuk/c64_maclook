# POLYHEDRON frame rates: frames drawn in 250 jiffies (5 s), per solid
dclick 292 30
wait 60
dclick 55 142
wait 300
dump phs_ico_a
wait 250
dump phs_ico_b
cmd 2
wait 100
dump phs_cube_a
wait 250
dump phs_cube_b
cmd 6
wait 100
dump phs_ball_a
wait 250
dump phs_ball_b
cmd H
wait 100
dump phs_wire_a
wait 250
dump phs_wire_b
